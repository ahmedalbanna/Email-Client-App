<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 5.1 — Cloud backup excludes sensitive; D2D allows for migration -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="email_database"/>
        <exclude domain="database" path="email_database-shm"/>
        <exclude domain="database" path="email_database-wal"/>
        <exclude domain="sharedpref" path="email_credentials_enc.xml"/>
        <exclude domain="sharedpref" path="email_credentials_fallback.xml"/>
        <exclude domain="file" path="attachments/"/>
        <include domain="sharedpref" path="ai_prefs.xml"/>
        <include domain="sharedpref" path="theme_prefs.xml"/>
        <include domain="sharedpref" path="ui_state.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="email_database"/>
        <include domain="sharedpref" path="email_credentials_enc.xml"/>
    </device-transfer>
</data-extraction-rules>
